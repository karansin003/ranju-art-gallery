# =========================================================
# Ranju Art Gallery — Environment Configuration Template
# =========================================================

# ===================== SERVER =====================
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===================== DATABASE (Supabase PostgreSQL) =====================
# For Supabase on Render/Production, use your connection string:
# Transaction Pooler (recommended): postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Or Direct: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Alternatively, configure with discrete parameters:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=postgres
DB_SSL=false

# ===================== AUTH & INITIAL SETUP =====================
# Generate a secure secret: openssl rand -hex 64
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=admin@gallery.com
ADMIN_NAME=Ranju Art Gallery

# ===================== FILE UPLOADS & CLOUDINARY =====================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===================== SITE DEFAULTS =====================
DEFAULT_ARTIST_NAME=Your Artist Name
DEFAULT_CONTACT_EMAIL=your-email@example.com
DEFAULT_CONTACT_PHONE=+91XXXXXXXXXX
DEFAULT_WHATSAPP_NUMBER=91XXXXXXXXXX
DEFAULT_INSTAGRAM_URL=https://www.instagram.com/your_username
DEFAULT_YOUTUBE_URL=https://www.youtube.com/@your_channel

# ===================== PAYMENTS (optional) =====================
# Leave blank to operate in "Order Request" mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
