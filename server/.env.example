# =========================================================
# Ranju Art Gallery — Backend Environment Configuration
# =========================================================

# ===================== SERVER =====================
PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ===================== DATABASE (Supabase PostgreSQL) =====================
# Supabase connection string:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Or discrete fallback:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password
DB_NAME=postgres
DB_SSL=false

# ===================== AUTH & INITIAL SETUP =====================
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d
ADMIN_INITIAL_PASSWORD=
ADMIN_EMAIL=admin@gallery.com
ADMIN_NAME=Ranju Art Gallery

# ===================== FILE UPLOADS & CLOUDINARY =====================
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=12
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===================== SITE DEFAULTS =====================
DEFAULT_ARTIST_NAME=Your Artist Name
DEFAULT_CONTACT_EMAIL=your-email@example.com
DEFAULT_CONTACT_PHONE=+91XXXXXXXXXX
DEFAULT_WHATSAPP_NUMBER=91XXXXXXXXXX
DEFAULT_INSTAGRAM_URL=https://www.instagram.com/your_username
DEFAULT_YOUTUBE_URL=https://www.youtube.com/@your_channel

# ===================== PAYMENTS (optional) =====================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
